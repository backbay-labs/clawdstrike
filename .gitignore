# Generated by Cargo
# will have compiled files and executables
/debug/
**/target/
!vendor/**/target/
!vendor/**/target/**

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# mdBook build output
docs/book

# Node.js
**/node_modules/

# Python
**/__pycache__/
*.pyc
.pytest_cache/
**/.pytest_cache/
**/.venv/
.tmp-reticulum-venv/

# Next.js build output
**/.next/

# TypeScript incremental builds
*.tsbuildinfo

# Local release artifacts
dist/

# Local diagnostics bundles
_diag/

# GSD planning artifacts
.planning/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# macOS
.DS_Store

.env

# .NET build artifacts
packages/sdk/hush-csharp/**/bin/
packages/sdk/hush-csharp/**/obj/
packages/sdk/hush-csharp/.vs/

# Playwright test results
**/test-results/

# Agent bundled daemon staging artifact
apps/agent/src-tauri/resources/bin/

# Moon
.moon/cache/

# Cursor
.cursor/
.claude/worktrees/
.planning/
**/.planning/

# Runtime artifacts (generated by test runs)
clawdstrike.events*.jsonl
clawdstrike.run.receipt*.json
clawdstrike.key
clawdstrike.key.pub

# Agent control-console bundled assets
apps/agent/src-tauri/resources/control-console/assets/
apps/agent/src-tauri/macos/

# Terminal beads
apps/terminal/.beads/

# Regorus .NET build artifacts
infra/vendor/regorus/**/obj/

# WASM build artifacts (wasm-pack output, ~2.4MB binary)
crates/libs/hush-wasm/pkg/
crates/libs/hush-wasm/pkg-node/

# Academy extracted sources (generated at build time)
apps/academy/src/data/extracted-sources/*.json

# Academy extracted rulesets (generated at build time)
apps/academy/src/data/rulesets/*.json

# Academy Pagefind search index (generated at postbuild)
apps/academy/public/pagefind/

# Vendored dependencies (local)
vendor/
!infra/vendor/
!infra/vendor/**
.planning/
