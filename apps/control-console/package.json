{
  "name": "@backbay/control-console",
  "version": "0.2.0",
  "private": true,
  "description": "ClawdStrike Control Console web app – BackbayOS desktop experience",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "biome check --write src/",
    "format:check": "biome check src/"
  },
  "dependencies": {
    "@backbay/glia": "^0.2.0",
    "@backbay/glia-desktop": "^0.2.0",
    "framer-motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-rnd": "^10.5.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
