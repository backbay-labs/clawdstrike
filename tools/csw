#!/usr/bin/env node

import { createConnection } from "node:net";
import { existsSync, readFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

// ---------------------------------------------------------------------------
// Exit codes
// ---------------------------------------------------------------------------
const EXIT_SUCCESS = 0;
const EXIT_RPC_ERROR = 1;
const EXIT_CONNECTION_FAILURE = 2;

// ---------------------------------------------------------------------------
// Help
// ---------------------------------------------------------------------------

function usage() {
  const text = `Usage: csw <method> [params-json] [options]

Options:
  --info <path>      Path to ipc.json (default: auto-detected from app data dir)
  --token <token>    Bearer token override (default: read from ipc.token)
  --retry <count>    Connection retry attempts (default: 1, env: CSW_RETRY)
  --result-only, -r  Output only the result field, not the full JSON-RPC envelope
  --quiet, -q        Suppress non-fatal stderr output (env: CSW_QUIET)
  --help, -h         Show this help

Examples:
  csw rpc.discover '{}'
  csw board.snapshot '{}'
  csw -r board.nodeAdd '{"nodeType":"note","title":"CVE Analysis"}'
  csw --retry 30 rpc.discover '{}'   # Wait up to 30s for workbench startup

Environment:
  CSW_RPC_INFO    Path to ipc.json
  CSW_RPC_TOKEN   Bearer token
  CSW_RETRY       Default retry count
  CSW_QUIET       Set to "1" for quiet mode

Exit codes:
  0  Success
  1  RPC error (method returned an error response)
  2  Connection failure (could not reach the workbench)`;

  process.stderr.write(text + "\n");
}

// ---------------------------------------------------------------------------
// Platform helpers
// ---------------------------------------------------------------------------

function defaultAppDataDir() {
  const home = homedir();
  if (process.platform === "darwin") {
    return join(home, "Library", "Application Support", "com.clawdstrike.workbench");
  }
  if (process.platform === "win32") {
    const appData = process.env.APPDATA ?? join(home, "AppData", "Roaming");
    return join(appData, "com.clawdstrike.workbench");
  }
  return join(process.env.XDG_DATA_HOME ?? join(home, ".local", "share"), "com.clawdstrike.workbench");
}

// ---------------------------------------------------------------------------
// Argument parsing
// ---------------------------------------------------------------------------

function parseArgs(argv) {
  const args = [...argv];
  let infoPath = process.env.CSW_RPC_INFO ?? join(defaultAppDataDir(), "ipc.json");
  let token = process.env.CSW_RPC_TOKEN ?? null;
  let retry = process.env.CSW_RETRY ? Number(process.env.CSW_RETRY) : 1;
  let quiet = process.env.CSW_QUIET === "1";
  let resultOnly = false;
  const positional = [];

  while (args.length > 0) {
    const arg = args.shift();
    if (arg === "--info") {
      infoPath = args.shift();
      continue;
    }
    if (arg === "--token") {
      token = args.shift();
      continue;
    }
    if (arg === "--retry") {
      retry = Number(args.shift());
      continue;
    }
    if (arg === "--result-only" || arg === "-r") {
      resultOnly = true;
      continue;
    }
    if (arg === "--quiet" || arg === "-q") {
      quiet = true;
      continue;
    }
    if (arg === "--help" || arg === "-h") {
      usage();
      process.exit(EXIT_SUCCESS);
    }
    positional.push(arg);
  }

  if (!infoPath) {
    throw new Error("Missing --info value");
  }

  // Clamp retry to [1, 60]
  if (!Number.isFinite(retry) || retry < 1) retry = 1;
  if (retry > 60) retry = 60;

  return {
    infoPath,
    token,
    retry,
    quiet,
    resultOnly,
    method: positional[0],
    paramsJson: positional[1] ?? "{}",
  };
}

// ---------------------------------------------------------------------------
// Runtime info & token
// ---------------------------------------------------------------------------

function readRuntimeInfo(infoPath) {
  if (!existsSync(infoPath)) {
    throw new Error(`RPC info file not found: ${infoPath}`);
  }
  const info = JSON.parse(readFileSync(infoPath, "utf8"));
  info._infoPath = infoPath;
  return info;
}

function resolveToken(runtimeInfo, explicitToken) {
  if (explicitToken) {
    return explicitToken;
  }
  const tokenPath = runtimeInfo.token_file;
  if (!tokenPath || !existsSync(tokenPath)) {
    throw new Error("RPC token file was not found and no --token override was provided");
  }
  return readFileSync(tokenPath, "utf8").trim();
}

// ---------------------------------------------------------------------------
// Transport
// ---------------------------------------------------------------------------

function connect(runtimeInfo) {
  if (runtimeInfo.transport === "unix") {
    return createConnection(runtimeInfo.endpoint);
  }
  if (runtimeInfo.transport === "tcp") {
    const host = runtimeInfo.host ?? "127.0.0.1";
    const port = runtimeInfo.port;
    if (typeof port !== "number") {
      throw new Error("TCP RPC runtime info is missing a port");
    }
    return createConnection(port, host);
  }
  throw new Error(`Unsupported RPC transport: ${runtimeInfo.transport}`);
}

// ---------------------------------------------------------------------------
// Single-shot RPC request
// ---------------------------------------------------------------------------

async function sendRequest(runtimeInfo, token, method, params) {
  const socket = connect(runtimeInfo);
  const payload = JSON.stringify({
    jsonrpc: "2.0",
    id: Date.now(),
    method,
    params,
    auth: `Bearer ${token}`,
  }) + "\n";

  return new Promise((resolve, reject) => {
    let buffer = "";

    socket.on("connect", () => {
      socket.write(payload);
    });

    socket.on("data", (chunk) => {
      buffer += chunk.toString("utf8");
      const newlineIndex = buffer.indexOf("\n");
      if (newlineIndex === -1) {
        return;
      }
      const line = buffer.slice(0, newlineIndex).trim();
      socket.end();
      if (!line) {
        reject(new Error("Received an empty RPC response"));
        return;
      }
      try {
        resolve(JSON.parse(line));
      } catch (error) {
        reject(error);
      }
    });

    socket.on("error", reject);
  });
}

// ---------------------------------------------------------------------------
// Retry wrapper
// ---------------------------------------------------------------------------

async function sendRequestWithRetry(infoPath, runtimeInfo, token, method, params, maxRetries, quiet) {
  let lastError;
  let currentInfo = runtimeInfo;
  for (let attempt = 1; attempt <= maxRetries; attempt++) {
    try {
      return await sendRequest(currentInfo, token, method, params);
    } catch (error) {
      lastError = error;
      if (attempt < maxRetries) {
        if (!quiet) {
          process.stderr.write(`csw: connection attempt ${attempt}/${maxRetries} failed, retrying in 1s...\n`);
        }
        await new Promise(resolve => setTimeout(resolve, 1000));
        // Re-read runtime info in case the port changed (Windows TCP restart)
        try {
          currentInfo = readRuntimeInfo(infoPath);
        } catch {
          // If info file disappeared, keep using previous info
        }
      }
    }
  }
  throw lastError;
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

async function main() {
  const { infoPath, token: explicitToken, method, paramsJson, retry, quiet, resultOnly } = parseArgs(process.argv.slice(2));
  if (!method) {
    usage();
    process.exit(EXIT_RPC_ERROR);
  }

  const runtimeInfo = readRuntimeInfo(infoPath);
  const token = resolveToken(runtimeInfo, explicitToken);

  let params;
  try {
    params = JSON.parse(paramsJson);
  } catch (error) {
    process.stderr.write(`csw: error: invalid params JSON — ${error instanceof Error ? error.message : String(error)}\n`);
    process.exit(EXIT_RPC_ERROR);
  }

  let response;
  try {
    response = await sendRequestWithRetry(infoPath, runtimeInfo, token, method, params, retry, quiet);
  } catch (error) {
    process.stderr.write(`csw: fatal: could not connect to workbench RPC socket — is the workbench running?\n`);
    if (!quiet) {
      process.stderr.write(`csw: detail: ${error instanceof Error ? error.message : String(error)}\n`);
    }
    process.exit(EXIT_CONNECTION_FAILURE);
  }

  // Handle RPC error response
  if (response?.error) {
    if (resultOnly) {
      process.stdout.write(JSON.stringify(response.error, null, 2) + "\n");
    } else {
      process.stdout.write(JSON.stringify(response, null, 2) + "\n");
    }
    process.stderr.write(`csw: error: ${method} — ${response.error.message ?? "unknown error"} (code ${response.error.code ?? "?"})\n`);
    process.exit(EXIT_RPC_ERROR);
  }

  // Success: output result or full envelope
  if (resultOnly) {
    process.stdout.write(JSON.stringify(response.result, null, 2) + "\n");
  } else {
    process.stdout.write(JSON.stringify(response, null, 2) + "\n");
  }
}

main().catch((error) => {
  process.stderr.write(`csw: fatal: ${error instanceof Error ? error.message : String(error)}\n`);
  process.exit(EXIT_CONNECTION_FAILURE);
});
